# 服务器上第一次运行 deploy/server-setup.sh 会自动生成 .env（随机密码），一般不用手抄这个文件。
# .env 只放在服务器上，不要发给别人，也不要传到网上。

DB_PASSWORD=
DB_ROOT_PASSWORD=

# 随机串，至少 32 位
APP_JWT_SECRET=

# 小程序后台 → 开发管理 → 开发设置。Secret 只在服务器上用 nano .env 自己填
WX_APPID=wx41efba8814b94670
WX_SECRET=

# 老板和你自己的 openid，逗号分隔（先在小程序里登录一次，再查 app_user 表）
APP_ADMIN_OPENIDS=

# 图片对外地址前缀：备案前用 http://服务器IP/files，备案后改成 https://你的域名/files
APP_PUBLIC_BASE_URL=http://127.0.0.1/files
APP_CORS_ORIGINS=http://127.0.0.1
